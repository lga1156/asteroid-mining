{
    "name": "@shri-students-template/frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "start": "vite",
        "dev": "vite",
        "build": "tsc -b && vite build",
        "types:generate": "openapi-typescript openapi.yaml -o src/types/openapi.generated.ts && prettier --write src/types/openapi.generated.ts",
        "preview": "vite preview",
        "lint": "eslint .",
        "test": "vitest run",
        "test:unit": "vitest run",
        "test:e2e": "playwright test --grep-invert @visual",
        "test:visual": "playwright test --grep @visual",
        "test:e2e:update": "playwright test --grep @visual --update-snapshots",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "@gravity-ui/icons": "^2.19.0",
        "@gravity-ui/uikit": "^7.43.0",
        "@tanstack/react-query": "^5.101.2",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-router-dom": "^7.18.1",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@eslint/js": "^9.35.0",
        "@playwright/test": "^1.62.0",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.2.4",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.0.4",
        "eslint": "^9.35.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^16.4.0",
        "jsdom": "^28.1.0",
        "openapi-typescript": "7.10.1",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.43.0",
        "vite": "^7.1.7",
        "vitest": "^4.1.10"
    }
}
